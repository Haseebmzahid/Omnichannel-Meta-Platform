# Staff portal frontend environment (Task 7-3). Vite only exposes
# VITE_-prefixed variables to client code — never put a secret in one of
# these, since it ends up in the built JS bundle. Copy to apps/web/.env for
# local development (gitignored, never commit a real value there either).

# Origin of the NestJS API (apps/api). Must match apps/api's own
# WEB_ORIGIN (see repo-root .env.example) for CORS + the credentialed
# session cookie to work — the two are kept as separate variables
# (one per app) rather than a single shared one, matching this monorepo's
# existing per-app config convention (see packages/config).
VITE_API_BASE_URL=http://localhost:3000
