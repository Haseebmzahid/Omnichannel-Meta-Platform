{
  "name": "@clinic/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS backend (webhook gateway, channel adapters, AI orchestrator, business services) — scaffolded, implementation pending.",
  "scripts": {
    "dev": "tsc -p tsconfig.json && concurrently -k -n tsc,node -c blue,green \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke:gemini": "tsx scripts/gemini-smoke-test.ts",
    "smoke:whatsapp": "tsx scripts/whatsapp-send-smoke-test.ts",
    "smoke:media-storage": "tsx scripts/media-storage-smoke-test.ts",
    "seed:knowledge": "tsx scripts/seed-clinic-knowledge.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@clinic/config": "workspace:*",
    "@google/genai": "^2.19.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  }
}
