# Environment configuration — populated incrementally as each subsystem is implemented.
# Never commit a real .env file. See docs/architecture/08-technology-stack.md for the full stack.

NODE_ENV=development

# --- Local PostgreSQL (docker-compose.yml) ---
# These values are only substituted into docker-compose.yml for the local dev
# container; the API does not read them directly (it reads DATABASE_URL,
# below). Change them here if you want different local credentials — the
# values shown are the same ones docker-compose.yml falls back to if this
# file (as .env) is absent.
POSTGRES_DB=clinic_dev
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic_dev_password
POSTGRES_PORT=5432

# Consumed by the API's validated config (packages/config) and by the Prisma
# CLI via apps/api/prisma.config.ts. Must match the POSTGRES_* values above.
# Optional in development/test — packages/config falls back to the value
# below (matching the POSTGRES_* defaults) when unset. REQUIRED when
# NODE_ENV=production: production never falls back to a local/Docker
# database, and the API fails fast at startup if this is missing there.
DATABASE_URL=postgresql://clinic:clinic_dev_password@localhost:5432/clinic_dev

# --- Gemini AI provider (Task 4C-6) ---
# Optional in development/test — the API boots and existing tests run
# without it. Required when NODE_ENV=production (packages/config enforces
# this and fails fast at startup if missing). Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# --- WhatsApp Cloud API inbound adapter ---
# Optional in development/test — the API boots and existing tests run
# without it. Required when NODE_ENV=production. Never commit real values.
# WHATSAPP_VERIFY_TOKEN: shared secret you also set in the Meta App
#   Dashboard's webhook subscription (GET verification challenge).
# WHATSAPP_APP_SECRET: your Meta App's secret, used to verify the
#   X-Hub-Signature-256 header on inbound webhook POSTs. Treat like a password.
# WHATSAPP_PHONE_NUMBER_ID: the WABA phone_number_id this deployment serves.
# WHATSAPP_CLINIC_ID: the (single) clinic that phone number belongs to.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CLINIC_ID=

# --- WhatsApp Cloud API outbound adapter ---
# WHATSAPP_ACCESS_TOKEN: System User (production) or temporary token for the
#   Cloud API's POST /{phone-number-id}/messages call. Treat like a password
#   — never commit, never log. Required when NODE_ENV=production.
# WHATSAPP_API_VERSION: Graph API version to call. Defaults to the version
#   verified current at implementation time; override if Meta retires it.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v26.0

# --- Instagram messaging inbound adapter (Page-linked path, ADR-008) ---
# Optional in development/test — the API boots and existing tests run
# without it. Required when NODE_ENV=production. Never commit real values.
# INSTAGRAM_VERIFY_TOKEN: shared secret you also set in the Meta App
#   Dashboard's Instagram webhook subscription (GET verification challenge).
# INSTAGRAM_APP_SECRET: your Meta App's secret, used to verify the
#   X-Hub-Signature-256 header on inbound webhook POSTs. Treat like a
#   password. Per ADR-008 this is the same App Secret as WhatsApp's in the
#   Meta Dashboard, but kept as its own variable here.
# INSTAGRAM_ACCOUNT_ID: the Instagram professional account id (webhook
#   recipient.id) this deployment serves.
# INSTAGRAM_CLINIC_ID: the (single) clinic that Instagram account belongs to.
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_CLINIC_ID=

# --- Instagram outbound send adapter ---
# INSTAGRAM_ACCESS_TOKEN: the Page access token for the Messenger/Instagram
#   Platform Send API's POST /me/messages call. Treat like a password —
#   never commit, never log. Required when NODE_ENV=production.
# INSTAGRAM_API_VERSION: Graph API version to call. Defaults to the version
#   verified current at implementation time; override if Meta retires it.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v26.0

# --- Facebook Page Messenger inbound webhook adapter (ADR-008) ---
# Optional in development/test — the API boots and existing tests run
# without it. Required when NODE_ENV=production. Never commit real values.
# MESSENGER_VERIFY_TOKEN: shared secret you also set in the Meta App
#   Dashboard's Page webhook subscription (GET verification challenge).
# MESSENGER_APP_SECRET: your Meta App's secret, used to verify the
#   X-Hub-Signature-256 header on inbound webhook POSTs. Treat like a
#   password. Per ADR-008 this is the same App Secret as WhatsApp's/
#   Instagram's in the Meta Dashboard, but kept as its own variable here.
# MESSENGER_PAGE_ID: the Facebook Page id (webhook recipient.id, and the id
#   the Send API's POST /{PAGE_ID}/messages is addressed to) this
#   deployment serves.
# MESSENGER_CLINIC_ID: the (single) clinic that Page belongs to.
MESSENGER_VERIFY_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_PAGE_ID=
MESSENGER_CLINIC_ID=

# --- Messenger outbound send adapter ---
# MESSENGER_ACCESS_TOKEN: the Page access token for the Messenger Platform
#   Send API's POST /{PAGE_ID}/messages call. Treat like a password — never
#   commit, never log. Required when NODE_ENV=production.
# MESSENGER_API_VERSION: Graph API version to call. Defaults to the version
#   verified current at implementation time; override if Meta retires it.
MESSENGER_ACCESS_TOKEN=
MESSENGER_API_VERSION=v26.0

# --- Staff auth (Task 7-2) ---
# Optional in development/test — a dev-only fallback secret is used so the
# API boots and existing tests run without it (see apps/api/src/auth/
# auth.module.ts). Required when NODE_ENV=production. Must be at least 32
# characters. Treat like a password — never commit a real value.
AUTH_JWT_SECRET=

# --- Staff portal frontend origin (Task 7-3) ---
# The exact origin (scheme+host+port) CORS allows to call this API with
# credentials (the session cookie). Defaults to Vite's own default dev
# port (apps/web/vite.config.ts). Set to the real deployed frontend origin
# in production.
WEB_ORIGIN=http://localhost:5173

# --- Media storage (Task 7-10) ---
# S3-compatible object storage for Attachment.storage_ref (real AWS S3, or
# any S3-compatible service — MinIO, Cloudflare R2, DigitalOcean Spaces).
# Optional in development/test — nothing calls this yet (no
# download-and-rehost pipeline, no browser-facing endpoint exists yet), so
# the API boots and existing tests run without any of these set. Never
# commit real values — the access key and secret are treated like passwords.
# MEDIA_STORAGE_ENDPOINT: custom S3-compatible endpoint URL (e.g. a local
#   MinIO). Leave unset to use real AWS S3's own regional endpoints.
# MEDIA_STORAGE_REGION: required by the S3 API even for non-AWS endpoints.
# MEDIA_STORAGE_BUCKET: the bucket name.
# MEDIA_STORAGE_ACCESS_KEY_ID / MEDIA_STORAGE_SECRET_ACCESS_KEY: credentials.
# MEDIA_STORAGE_FORCE_PATH_STYLE: MinIO/most non-AWS services require
#   path-style addressing; defaults to true.
MEDIA_STORAGE_ENDPOINT=
MEDIA_STORAGE_REGION=us-east-1
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_ACCESS_KEY_ID=
MEDIA_STORAGE_SECRET_ACCESS_KEY=
MEDIA_STORAGE_FORCE_PATH_STYLE=true
