# Environment configuration — populated incrementally as each subsystem is implemented.
# Never commit a real .env file. See docs/architecture/08-technology-stack.md for the full stack.

NODE_ENV=development

# --- Local PostgreSQL (docker-compose.yml) ---
# These values are only substituted into docker-compose.yml for the local dev
# container; the API does not read them directly (it reads DATABASE_URL,
# below). Change them here if you want different local credentials — the
# values shown are the same ones docker-compose.yml falls back to if this
# file (as .env) is absent.
POSTGRES_DB=clinic_dev
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic_dev_password
POSTGRES_PORT=5432

# Consumed by the API's validated config (packages/config) and by the Prisma
# CLI via apps/api/prisma.config.ts. Must match the POSTGRES_* values above.
DATABASE_URL=postgresql://clinic:clinic_dev_password@localhost:5432/clinic_dev

# --- Gemini AI provider (Task 4C-6) ---
# Optional in development/test — the API boots and existing tests run
# without it. Required when NODE_ENV=production (packages/config enforces
# this and fails fast at startup if missing). Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# --- WhatsApp Cloud API inbound adapter ---
# Optional in development/test — the API boots and existing tests run
# without it. Required when NODE_ENV=production. Never commit real values.
# WHATSAPP_VERIFY_TOKEN: shared secret you also set in the Meta App
#   Dashboard's webhook subscription (GET verification challenge).
# WHATSAPP_APP_SECRET: your Meta App's secret, used to verify the
#   X-Hub-Signature-256 header on inbound webhook POSTs. Treat like a password.
# WHATSAPP_PHONE_NUMBER_ID: the WABA phone_number_id this deployment serves.
# WHATSAPP_CLINIC_ID: the (single) clinic that phone number belongs to.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CLINIC_ID=

# --- WhatsApp Cloud API outbound adapter ---
# WHATSAPP_ACCESS_TOKEN: System User (production) or temporary token for the
#   Cloud API's POST /{phone-number-id}/messages call. Treat like a password
#   — never commit, never log. Required when NODE_ENV=production.
# WHATSAPP_API_VERSION: Graph API version to call. Defaults to the version
#   verified current at implementation time; override if Meta retires it.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v26.0

# --- Instagram messaging inbound adapter (Page-linked path, ADR-008) ---
# Optional in development/test — the API boots and existing tests run
# without it. Required when NODE_ENV=production. Never commit real values.
# INSTAGRAM_VERIFY_TOKEN: shared secret you also set in the Meta App
#   Dashboard's Instagram webhook subscription (GET verification challenge).
# INSTAGRAM_APP_SECRET: your Meta App's secret, used to verify the
#   X-Hub-Signature-256 header on inbound webhook POSTs. Treat like a
#   password. Per ADR-008 this is the same App Secret as WhatsApp's in the
#   Meta Dashboard, but kept as its own variable here.
# INSTAGRAM_ACCOUNT_ID: the Instagram professional account id (webhook
#   recipient.id) this deployment serves.
# INSTAGRAM_CLINIC_ID: the (single) clinic that Instagram account belongs to.
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_CLINIC_ID=

# --- Instagram outbound send adapter ---
# INSTAGRAM_ACCESS_TOKEN: the Page access token for the Messenger/Instagram
#   Platform Send API's POST /me/messages call. Treat like a password —
#   never commit, never log. Required when NODE_ENV=production.
# INSTAGRAM_API_VERSION: Graph API version to call. Defaults to the version
#   verified current at implementation time; override if Meta retires it.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v26.0
