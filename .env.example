# Environment configuration — populated incrementally as each subsystem is implemented.
# Never commit a real .env file. See docs/architecture/08-technology-stack.md for the full stack.

NODE_ENV=development

# --- Local PostgreSQL (docker-compose.yml) ---
# These values are only substituted into docker-compose.yml for the local dev
# container; the API does not read them directly (it reads DATABASE_URL,
# below). Change them here if you want different local credentials — the
# values shown are the same ones docker-compose.yml falls back to if this
# file (as .env) is absent.
POSTGRES_DB=clinic_dev
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic_dev_password
POSTGRES_PORT=5432

# Consumed by the API's validated config (packages/config) and by the Prisma
# CLI via apps/api/prisma.config.ts. Must match the POSTGRES_* values above.
DATABASE_URL=postgresql://clinic:clinic_dev_password@localhost:5432/clinic_dev
